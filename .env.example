# Shopware of this restaurant. In production the internal address in the same compose stack (e.g. http://web:8000).
NUXT_SHOPWARE_URL=http://localhost:8000
# Shown in the header
NUXT_RESTAURANT_NAME=Trattoria
# Optional: sales channels to show, in this order, each with the menu category the storefront uses
# (its NUXT_PUBLIC_SHOP_BITE_MENU_CATEGORY_ID). Empty = every active sales channel, menu = its navigation category.
NUXT_SALES_CHANNELS=
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars
