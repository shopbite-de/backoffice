# Shopware of this restaurant. In production the internal address in the same compose stack (e.g. http://web:8000).
NUXT_SHOPWARE_URL=http://localhost:8000
# Shown in the header
NUXT_RESTAURANT_NAME=Trattoria
# Optional: sales channels to show, in this order. Empty = every active sales channel. The menu category comes from
# the plugin configuration ("Kategorie der Speisekarte", per sales channel); "channelId:menuCategoryId" overrides it.
NUXT_SALES_CHANNELS=
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars
# Optional: storefronts of this installation (comma separated); the backoffice empties their cache after a menu
# change, so guests see it at once. Needs the same NUXT_CACHE_PURGE_SECRET as in the storefronts.
NUXT_STOREFRONT_URLS=
NUXT_CACHE_PURGE_SECRET=
